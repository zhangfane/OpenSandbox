{
  "name": "@opensandbox/console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm gen:api && vite --host 127.0.0.1",
    "gen:api": "openapi-typescript ../specs/sandbox-lifecycle.yml -o src/api/lifecycle.gen.ts && openapi-typescript ../specs/diagnostic-api.yml -o src/api/diagnostic.gen.ts && node scripts/form-schema.mjs",
    "build": "pnpm gen:api && tsc -b && vite build",
    "build:server": "pnpm build && node scripts/stage-server.mjs",
    "typecheck": "pnpm gen:api && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "pnpm gen:api && vitest run",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.0.0",
    "@tanstack/react-query": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.6",
    "lucide-react": "^0.468.0",
    "openapi-fetch": "^0.14.1",
    "radix-ui": "^1.6.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.0.0",
    "react-router-dom": "^7.0.0",
    "sonner": "^2.0.0",
    "tailwind-merge": "^3.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.0.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.0",
    "yaml": "^2.9.1"
  }
}
